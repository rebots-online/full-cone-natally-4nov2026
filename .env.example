VITE_NATALLY_MASCOT_URL="/natally-mascot.webp"
# @public VITE_NATALLY_HEADER_SIZE
VITE_NATALLY_HEADER_SIZE="72"
# @public VITE_NATALLY_SPEAKING_SIZE
VITE_NATALLY_SPEAKING_SIZE="112"

# Optional authenticated commerce adapter; leave unset until the real
# catalog/verification service is deployed.
#VITE_DOWNLOAD_ACCESS_API_URL=""

# Visible output plus reasoning budget; reading length is not a word quota.
