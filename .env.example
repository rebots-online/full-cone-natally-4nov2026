# Required application identity. Configure your fork's own name and publisher-owned ID.
APP_NAME=""
APP_IDENTIFIER=""

# Public Google Analytics web-stream measurement ID for actual usage events.
# Leave blank for an unconfigured fork; configure your own existing G- stream ID.
# Only bounded scene/interaction metadata is sent; no account or reading content.
# @public VITE_GA_MEASUREMENT_ID
VITE_GA_MEASUREMENT_ID=""

# Direct browser inference uses the account user key connected in Account settings.
# OPENROUTER_API_KEY below is for operator tooling; no key is embedded by Vite.
# Public voice defaults, embedded at build time: edit .env then rebuild/redeploy.
# Speaker: F1-F5, M1, M2. Pitch/rate: 0.8-1.4. Pitch also speeds up playback.
# A changed preset migrates saved audio settings while retaining mute/avatar/sprite.
VITE_NATALLY_VOICE="F4"
# @public VITE_NATALLY_VOICE
VITE_NATALLY_VOICE_PITCH="1.15"
# @public VITE_NATALLY_VOICE_PITCH
VITE_NATALLY_VOICE_RATE="0.90"
# @public VITE_NATALLY_VOICE_RATE
# Maximum chunk characters, 100-800; adaptive policy caps at 240 (180 on gentle/slow devices).
VITE_NATALLY_SPEECH_CHUNK_CHARS="240"
# @public VITE_NATALLY_SPEECH_CHUNK_CHARS

# Public spontaneous character stories: no paid inference or credit usage.
# Enable authored voice only during visible conversational quiet with read-aloud on.
# The next delay is chosen within these bounds after speech, typing or interruptions.
VITE_NATALLY_NUDGES_ENABLED="true"
# @public VITE_NATALLY_NUDGES_ENABLED
VITE_NATALLY_NUDGE_MIN_SECONDS="90"
# @public VITE_NATALLY_NUDGE_MIN_SECONDS
VITE_NATALLY_NUDGE_MAX_SECONDS="150"
# @public VITE_NATALLY_NUDGE_MAX_SECONDS

# Completed free educational answers between authored personal-reading invitations.
# Both bounds are inclusive integers from 2 through 4; minimum must not exceed maximum.
# These invitations use no paid generation and do not change credits or paid access.
# @public VITE_EDUCATION_INVITE_MIN_ANSWERS
VITE_EDUCATION_INVITE_MIN_ANSWERS="2"
# @public VITE_EDUCATION_INVITE_MAX_ANSWERS
VITE_EDUCATION_INVITE_MAX_ANSWERS="4"

# Public seasonal room decorations, embedded at build time; rebuild/redeploy after changes.
# false omits that choice and uses candlelit while retaining its saved preference/assets.
# true makes that existing decoration available again; no calendar auto-enabling.
# @public VITE_ATELIER_HALLOWEEN_ENABLED
VITE_ATELIER_HALLOWEEN_ENABLED=false
# @public VITE_ATELIER_CHRISTMAS_ENABLED
VITE_ATELIER_CHRISTMAS_ENABLED=false

# Direct browser inference uses openrouter/free; no Netlify LLM function.
# There is no GLM or paid fallback in the browser client.
# OPENROUTER_ADMIN_KEY is for billing provisioning, never inference.
# Firebase Web configuration key; credential-bearing, never projected.
# @credential FIREBASE_API_KEY
FIREBASE_API_KEY=""
# Netlify Functions secrets only; never prefix these with VITE_.
# Operator-granted development access bindings for the verified development
# account; access continues to follow DOCS/BILLING-SPEC.md while billing is
# @credential NATALLY_DEV_OPENROUTER_KEY
NATALLY_DEV_ACCESS_EMAIL=""
NATALLY_DEV_ACCESS_EXPIRES_AT=""
NATALLY_DEV_OPENROUTER_KEY=""
FRONTEND_ORIGIN=""

# GEMINI_API_KEY: Direct Gemini access (legacy engine; also powers TTS when present).
# GOOGLE_API_KEY: Direct Google AI access (separate Google credential document).
# @credential GEMINI_API_KEY
# @credential GOOGLE_API_KEY
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# ── Inference engines ────────────────────────────────────────────────────────
# INFERENCE_ENGINE selects the chat/readings engine:
#   openrouter        — OpenRouter free tier via OPENROUTER_API_KEY (auto-default
#                       when that key is present)
#   gemini            — direct GEMINI_API_KEY access
#   openai-compatible — any OpenAI-shaped endpoint via CUSTOM_LLM_* (z.ai GLM
#                       Coding Plan, Ollama, LM Studio, …)
#   venice            — direct VENICE_API_KEY access
#   venice-admin      — reserved: admin-key provisioning of spend-limited user keys
#   openrouter-admin  — reserved: per-user provisioned keys (40% of top-up)
#   local             — reserved: atomic-chat llama.cpp / wllama3, no spend limit
# Unset = auto (openrouter if OPENROUTER_API_KEY present, else gemini).
#INFERENCE_ENGINE=""

# ── OpenRouter operator tooling / optional legacy local server ──────────────
# @credential OPENROUTER_API_KEY
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Local server only: OPENROUTER_MODEL is an optional explicit model id. Unset = free-tier chain
# (deepseek-chat-v3-0324:free → llama-3.3-70b:free → gemma-3-27b:free) with
# automatic fallback when a free model is delisted or rate-capped.
#OPENROUTER_MODEL=""

# ── OpenRouter admin (billing provisioning service only) ──────────────────
# @credential OPENROUTER_ADMIN_KEY
OPENROUTER_ADMIN_KEY=""

# ── Billing policy: DOCS/BILLING-SPEC.md ────────────────────────────────────
# Apply server settings to the deployment after changing .env.
# Empty initial allowance/catalog intentionally means purchasing unavailable.
BILLING_POLICY_VERSION="v2"
# Customer credits approximate tokens for usage estimates, not questions/turns.
# This unit does not establish a fixed token count or USD conversion; the
# configured inference allocation and its cost cap remain separate settings.
BILLING_CREDIT_UNIT="approximate_token"
# Customer credit balance store selection. This setting records the agreed
# Firebase semantics; it does not itself implement accounting or provisioning.
BILLING_CREDIT_BALANCE_STORE="firebase"
BILLING_OFFER_PRICE_USD=""
# Historical souvenir compatibility setting; not the customer credit unit.
# Current customer credits approximate tokens, not questions/completed turns.
BILLING_INCLUDED_TURNS=""
BILLING_INCLUDED_INFERENCE_USD=""
BILLING_TOPUP_ALLOCATION_BPS=""
BILLING_ARCHIVE_ACCESS_YEARS=""
BILLING_COST_PAYMENT_USD=""
BILLING_COST_GENERATION_USD=""
BILLING_COST_HOSTING_YEAR_USD=""
BILLING_COST_SUPPORT_USD=""
BILLING_COST_FIXED_SUBSIDY_USD=""
BILLING_COST_RESERVE_USD=""
# JSON object keyed by exact platform product identifiers. Each actual mapping
# requires creditQuantity (positive safe integer), currency ("USD") and kind
# ("credits" or "souvenir"). Credit quantities are explicit Firebase grants,
# never inferred from price, tier, tokens or a historical completed-turn count.
# A souvenir also requires inferenceAllowanceUsdMicros (nonnegative safe integer).
# Credit-pack provider allowance is floor(verified eligible paid USD micros *
# BILLING_TOPUP_ALLOCATION_BPS / 10000); the credit grant stays separately configured.
# Leave unavailable product mappings empty; do not invent identifiers or quantities.
BILLING_PRODUCTS_JSON=""
# Server-side redemption settings. The accepted code is case-sensitive and keeps
# its punctuation; the code and stable campaign ID belong to this installation.
# Campaign identifies one durable grant per authenticated account, not a payment.
BILLING_REDEMPTION_CODE=""
BILLING_REDEMPTION_CAMPAIGN=""
# Firebase credit quantity must come from the actual dollar-to-credit policy.
# Do not assume a conversion rate; use the configured dollar-to-credit policy.
BILLING_REDEMPTION_CREDITS=""
# Explicit nonnegative USD allowance with at most six fractional digits.
# Installation example: "10.00" represents USD 10 exactly, without a credit conversion.
# Blank is unconfigured, not a zero-value allowance.
# These settings alone do not create a receipt, credit balance or usable key.
BILLING_REDEMPTION_ALLOWANCE_USD=""
BILLING_ENVIRONMENT="PRODUCTION"
BILLING_ALLOWED_ORIGIN=""
REVENUECAT_PROJECT_ID=""
REVENUECAT_OFFERING_ID=""
# @credential REVENUECAT_SECRET_API_KEY
REVENUECAT_SECRET_API_KEY=""
# RevenueCat webhook authorization token (server-side only).
# @credential REVENUECAT_WEBHOOK_AUTH
REVENUECAT_WEBHOOK_AUTH=""
# Public SDK/catalog bindings must match this installation's actual provider setup.
# Android uses the goog_ key and verified Google Play product/base-plan IDs.
# Missing native product bindings leave Play quotes unavailable; never invent IDs.
# The two public SDK keys are credential-bearing SDK bindings held as
# pointers, and are the only credential fields approved for frontend
# projection; the other RevenueCat catalog/entitlement identifiers below are
# public as well.
# @credential VITE_REVENUECAT_PUBLIC_KEY
# @public VITE_REVENUECAT_PUBLIC_KEY
VITE_REVENUECAT_PUBLIC_KEY=""
# @credential VITE_REVENUECAT_ANDROID_PUBLIC_KEY
# @public VITE_REVENUECAT_ANDROID_PUBLIC_KEY
VITE_REVENUECAT_ANDROID_PUBLIC_KEY=""
# @public VITE_REVENUECAT_OFFERING_ID
VITE_REVENUECAT_OFFERING_ID=""
# @public VITE_REVENUECAT_READING_PACKAGE_ID
VITE_REVENUECAT_READING_PACKAGE_ID=""
# @public VITE_REVENUECAT_CONVERSATION_PACKAGE_ID
VITE_REVENUECAT_CONVERSATION_PACKAGE_ID=""
# @public VITE_REVENUECAT_READING_PRODUCT_ID
VITE_REVENUECAT_READING_PRODUCT_ID=""
# @public VITE_REVENUECAT_CONVERSATION_PRODUCT_ID
VITE_REVENUECAT_CONVERSATION_PRODUCT_ID=""
# @public VITE_REVENUECAT_ANDROID_READING_PRODUCT_ID
VITE_REVENUECAT_ANDROID_READING_PRODUCT_ID=""
# @public VITE_REVENUECAT_ANDROID_CONVERSATION_PRODUCT_ID
VITE_REVENUECAT_ANDROID_CONVERSATION_PRODUCT_ID=""
# Conversation packs: JSON array of objects, each with required fields cadence
# ("monthly"|"one_time"), tier ("1"|"5"|"10"|"25") and packageIdentifier (the
# actual RevenueCat package ID); optional webProductIdentifier and
# androidProductIdentifier carry the actual platform product IDs.
# Tier is a selector slot (1|5|10|25); the provider owns the actual price,
# currency and cadence. A real native product does not imply a Web product.
# Platform product IDs are optional per platform; blank means no active packs.
# @public VITE_REVENUECAT_CONVERSATION_PACKS_JSON
VITE_REVENUECAT_CONVERSATION_PACKS_JSON=""
# Default selector tier for credit packs: monthly first, then one-time of the
# same tier. If unavailable, leave selection to the customer; never substitute
# another tier. This slot is not a price or a currency-grant/conversion amount.
# @public VITE_REVENUECAT_DEFAULT_CREDIT_TIER
VITE_REVENUECAT_DEFAULT_CREDIT_TIER="5"
# @public VITE_REVENUECAT_READING_ENTITLEMENT_ID
VITE_REVENUECAT_READING_ENTITLEMENT_ID=""
# @public VITE_REVENUECAT_DOWNLOAD_ENTITLEMENT_ID
VITE_REVENUECAT_DOWNLOAD_ENTITLEMENT_ID=""
# @public VITE_REVENUECAT_TERMS_URL
VITE_REVENUECAT_TERMS_URL=""
# Billing API base URL for hosted service calls; set once the verified service
# is deployed (base URL before /billing/*). Blank until then; never fabricate.
# @public VITE_BILLING_API_URL
VITE_BILLING_API_URL=""
# x402 payment facilitator endpoint used by the browser client; blank until a
# real facilitator URL is configured.
# @public VITE_X402_FACILITATOR_URL
VITE_X402_FACILITATOR_URL=""
# Service-account JSON for server-side Firebase admin; credential-bearing,
# @credential FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Surge deployment token for the operator's hosting account.
# @credential SURGE_TOKEN
SURGE_TOKEN=""
# Billing key encryption key (server-side envelope encryption).
# @credential BILLING_KEY_ENCRYPTION_KEY
BILLING_KEY_ENCRYPTION_KEY=""
# Credential-bearing database URL for the billing service.
# @credential BILLING_DATABASE_URL
BILLING_DATABASE_URL=""
# Android release signing configuration. Keystore path and key alias are
# the public expected certificate fingerprint. Unknown values stay empty; the
# release worker verifies actual production bindings.
ANDROID_KEYSTORE_PATH=""
ANDROID_KEY_ALIAS=""
# @credential ANDROID_KEYSTORE_PASSWORD
ANDROID_KEYSTORE_PASSWORD=""
# @credential ANDROID_KEY_PASSWORD
ANDROID_KEY_PASSWORD=""
ANDROID_SIGNING_CERT_SHA256=""

# Coordinator-owned release metadata; authored only by the release coordinator,
# never as active assignments in tracked env files:
#NATALLY_RELEASE_ID=""
#NATALLY_DEPLOY_COORDINATOR=""
#NATALLY_DEPLOY_INVENTORY=""
#RELEASE_SOURCE_COMMIT=""

# ── Venice.ai ────────────────────────────────────────────────────────────────
# @credential VENICE_API_KEY
VENICE_API_KEY=""
VENICE_BASE_URL="https://api.venice.ai/api/v1"
# VENICE_MODEL: optional default model slug (unset = venice-uncensored-1-2;
